# Copy this file to .env and fill in the values.
# Keep comments on their own lines: inline comments are not part of the .env format.

# ---------- Server ----------
PORT=4000
# CORS allow-list. Comma-separated; add your Vercel URL in production.
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database: Neon Postgres (free). pgvector lives in the same database. ----------
# Use the POOLED connection string (host contains "-pooler").
# Change sslmode=require to sslmode=verify-full (same security today, no pg warning).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full

# ---------- Auth ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters-from-the-command-above
JWT_EXPIRES_IN=7d

# ---------- LLM provider toggle ----------
# Option A: local + private (Ollama). Requires the Ollama app running and: ollama pull llama3.2:3b
# LLM_API_KEY is ignored by Ollama but the OpenAI SDK requires a value.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Option B: cloud (OpenRouter). Comment out Option A and uncomment the lines below.
# Pick a current free model at https://openrouter.ai/models (filter: free).
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# LLM_MODEL=poolside/laguna-s-2.1:free
# Optional backups OpenRouter tries in order if the model above is busy (free models often are):
# LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# LLM_BASE_URL and LLM_MODEL may be left empty: the preset for LLM_PROVIDER fills them in.

# ---------- Embeddings (run in-process; no key needed) ----------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Must match vector(384) in src/db/schema.sql
EMBEDDING_DIMENSIONS=384

# ---------- RAG tuning ----------
RAG_TOP_K=5
RAG_EF_SEARCH=100
# Cosine similarity (1 - distance). Chunks scoring below this are ignored.
RAG_MIN_SCORE=0.35
